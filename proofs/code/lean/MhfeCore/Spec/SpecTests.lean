/-- The length rules on the cases of the text. -/
example : lengthRules none [] = some [24] ∧ lengthRules none [15] = some [15] ∧
    lengthRules none [12, 21] = some [12, 21, 24] ∧ lengthRules (some 15) [12, 15] = some [15] ∧
    lengthRules (some 18) [12] = some [12] ∧ lengthRules (some 18) [] = none ∧
    lengthRules (some 24) [12] = some [12, 24] ∧ lengthRules (some 24) [] = some [24] := by decide +kernel

