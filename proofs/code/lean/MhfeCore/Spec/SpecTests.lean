import MhfeCore.Spec.Spec

/-!
# Checks of the byte-level specification against the specification's vectors

Each example below takes bytes from a transcript of the specification's vectors (`mhfe_spec`
`98620cc`, `vectors/`) and checks that the definitions of `Spec.lean` give the same bytes: the
salt and mask inputs `D_i` and `D'_i` (domain strings, settings, `ENT`, round index and half), and
one round's XOR and swap. The hash outputs are taken from the transcript, since the hash functions
are parameters of the specification.
-/

open Aeneas Aeneas.Std MhfeSpec

namespace MhfeSpecTests

def bytesOf (l : List Nat) : Bytes := l.map byte

/-- suite3/zero-12.json, round 0: `D_i`. -/
