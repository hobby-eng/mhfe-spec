{
  "description": "Unicode 18 extension cases. Expected NFKD bytes follow the Unicode 18.0.0 UnicodeData.txt mappings and combining classes; independent-suite3.py passwords checks them with unicodedata2 18.0.0. No Argon2 work is needed.",
  "passwords": [
    {
      "id": "new-subscript-w",
      "input_utf8_hex": "e2829d",
      "expected_nfkd_utf8_hex": "77",
      "note": "U+209D is unassigned in Unicode 17; Unicode 18 decomposes it to U+0077"
    },
    {
      "id": "new-armenian-modifier",
      "input_utf8_hex": "d598",
      "expected_nfkd_utf8_hex": "d5a7",
      "note": "U+0558 decomposes to U+0567 in Unicode 18"
    },
    {
      "id": "new-supplementary-modifier",
      "input_utf8_hex": "f0909ebb",
      "expected_nfkd_utf8_hex": "ca87",
      "note": "U+107BB decomposes to U+0287"
    },
    {
      "id": "new-combining-class-reorders-old-mark",
      "input_utf8_hex": "61cc81d788",
      "expected_nfkd_utf8_hex": "61d788cc81",
      "note": "New U+05C8 has class 10 and precedes U+0301 of class 230"
    },
    {
      "id": "new-decomposition-fits-byte-limit",
      "repeat_utf8_hex": "e2829d",
      "count": 1024,
      "expected_nfkd_bytes": 1024
    },
    {
      "id": "new-decomposition-crosses-byte-limit",
      "repeat_utf8_hex": "e2829d",
      "count": 1025,
      "expected_error": "PASSWORD_TOO_LONG",
      "expected_nfkd_bytes": 1025
    },
    {
      "id": "unassigned-still-refused",
      "input_utf8_hex": "61cdb8",
      "expected_error": "UNASSIGNED_CHARACTER",
      "note": "U+0378 remains unassigned in Unicode 18"
    },
    {
      "id": "controls-still-refused-with-new-character",
      "input_utf8_hex": "e2829d0a",
      "expected_error": "CONTROL_CHARACTER_IN_PASSWORD"
    }
  ]
}
